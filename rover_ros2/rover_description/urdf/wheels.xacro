<?xml version="1.0" encoding="utf-8"?>
<robot name="wheels" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- FRONT LEFT WHEEL -->
    <link name="front_left_wheel_link">
        <inertial>
            <origin
            xyz="0 -1.38777878078145E-17 -0.00226675278429586"
            rpy="0 0 0" />
            <mass value="3.30391410914092" />
            <inertia
                ixx="0.014080784493695"
                ixy="0"
                ixz="-5.05077307590103E-20"
                iyy="0.014080784493695"
                iyz="7.67217406475748E-20"
                izz="0.023364919828031" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://rover_description/meshes/Wheel1.STL" />
            </geometry>
            <material name="">
                <color
                    rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://rover_description/meshes/Wheel1.STL" />
            </geometry>
        </collision>
    </link>

    <joint name="front_left_wheel_joint" type="continuous">
        <origin
            xyz="0.2863 0 0.11332"
            rpy="1.5708 -0.036526 0" />
        <parent link="chassis_link" />
        <child link="front_left_wheel_link" />
        <axis xyz="0 0 -1" />
    </joint>



