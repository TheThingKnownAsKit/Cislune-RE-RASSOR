<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_hardware</name>
  <version>1.0.0</version>
  <description>This ROS2 package contains all the Hardware Components for ROS2 Control.</description>
  <maintainer email="moodyellam@gmail.com">Ella Moody</maintainer>
  <author email="moodyellam@gmail.com">Ella Moody</author>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>libserial-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
